---
import type { Producer } from '../lib/data';

interface Props {
    producer: Producer;
}

const { producer } = Astro.props;
---

<div class="card producer-card" style="display: flex; flex-direction: column;">
    <div style="position: relative; height: 120px; overflow: hidden; background: #e2e8f0;">
        <img 
            src={producer.cover_image_url} 
            alt={producer.brand_name} 
            style="width: 100%; height: 100%; object-fit: cover;"
        />
        <div style="position: absolute; top: 10px; right: 10px;">
            <span class="badge badge-city" style="display: inline-flex; align-items: center; gap: 4px;">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                {producer.city}
            </span>
        </div>
    </div>

    <div style="padding: 1.2rem; flex: 1; display: flex; flex-direction: column;">
        <div style="display: flex; align-items: center; gap: 0.8rem; margin-top: -38px; margin-bottom: 0.8rem;">
            <img 
                src={producer.logo_url} 
                alt={producer.brand_name} 
                style="width: 56px; height: 56px; border-radius: 999px; object-fit: cover; border: 3px solid #fff; box-shadow: 0 4px 10px rgba(0,0,0,0.15);"
            />
            <div style="padding-top: 20px;">
                <h3 style="font-size: 1.1rem; font-weight: 700; margin: 0;">
                    <a href={`/uretici/${producer.slug}`}>{producer.brand_name}</a>
                </h3>
                <span style="font-size: 0.78rem; color: #64748b;">{producer.category}</span>
            </div>
        </div>

        <p style="font-size: 0.85rem; color: var(--color-ink-muted); line-height: 1.4; margin-bottom: 1rem; flex: 1; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
            {producer.description}
        </p>

        <div style="display: flex; align-items: center; justify-content: space-between; font-size: 0.8rem; padding: 0.6rem 0.8rem; background: var(--color-paper); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-sm); margin-bottom: 1rem;">
            <span style="display: flex; align-items: center; gap: 4px;">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="#f59e0b" stroke="#f59e0b"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <strong>{producer.rating}</strong> ({producer.review_count} yorum)
            </span>
            <span>{producer.sales_count}+ teslimat</span>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
            <a href={`/uretici/${producer.slug}`} class="btn btn-sm btn-primary">
                Atölyeyi Gör
            </a>
            <a href={producer.instagram_url} target="_blank" rel="noopener" class="btn btn-sm btn-instagram" style="font-size: 0.75rem; display: flex; align-items: center; justify-content: center; gap: 4px;">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
                {producer.instagram_handle}
            </a>
        </div>
    </div>
</div>
