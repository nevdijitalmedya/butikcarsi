---
import { CATEGORIES } from '../lib/data';
---

<header class="site-header">
    <div class="header-top">
        <div class="container d-flex justify-content-between align-items-center">
            <span style="display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#ff8a65" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                <span class="d-none-mobile">%100 Güvenli Alışveriş • Escrow (Emanet) Korumalı Ödeme • Kişiye Özel Butik Üretim</span>
     <span class="d-block-mobile" style="display:none; font-size:0.75rem;">%100 Güvenli Butik Alışveriş • Escrow Koruması</span>
            </span>
        </div>
    </div>

    <div class="container">
        <div class="header-main">
            <a href="/" class="logo-wrap" title="ButikÇarşı Anasayfa">
                <div class="logo-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                        <path d="M3 6h18"/>
                        <path d="M16 10a4 4 0 0 1-8 0"/>
                    </svg>
                </div>
                <span>ButikÇarşı</span>
            </a>

            <div class="search-bar">
                <span class="search-icon">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="m21 21-4.3-4.3"/>
                    </svg>
                </span>
                <input type="text" placeholder="Lazer kolye, epoksi saat, hasır çanta ara..." id="site-search-input">
            </div>

            <div class="header-actions">
                <a href="/uretici-ol" class="btn btn-sm btn-secondary d-none-mobile">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/>
                    </svg>
                    <span>Üretici Ol</span>
                </a>
                <a href="/panel/producer/login.php" class="btn btn-sm btn-secondary" target="_blank" rel="noopener">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m2 7 4.4-4.4A2 2 0 0 1 7.8 2h8.4a2 2 0 0 1 1.4.6L22 7"/>
                        <path d="M22 7v13a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7"/>
                        <path d="M12 11a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z"/>
                    </svg>
                    <span>Atölye Girişi</span>
                </a>
                <a href="/sepet" class="btn btn-primary btn-sm" style="position: relative;">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                        <path d="M3 6h18"/>
                        <path d="M16 10a4 4 0 0 1-8 0"/>
                    </svg>
                    <span>Sepet</span>
                    <span id="header-cart-count" style="display: none; position: absolute; top: -6px; right: -6px; background: #0f172a; color: #fff; border-radius: 999px; width: 20px; height: 20px; font-size: 0.7rem; align-items: center; justify-content: center; font-weight: bold;">0</span>
                </a>
            </div>
        </div>

        <nav class="nav-pills">
            <a href="/kesfet" class="nav-pill" style="display: inline-flex; align-items: center; gap: 6px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
                </svg>
                <span>Tüm Butikler</span>
            </a>

            <!-- Kişiye Özel Hediyelik -->
            <a href="/kategori/kisiye-ozel-hediyelik" class="nav-pill" style="display: inline-flex; align-items: center; gap: 6px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="8" width="18" height="14" rx="2"/>
                    <path d="M12 8v14"/>
                    <path d="M19 8a3 3 0 0 0-3-3c-1.5 0-3 1.5-4 3 1-1.5 2.5-3 4-3a3 3 0 0 1 3 3Z"/>
                    <path d="M5 8a3 3 0 0 1 3-3c1.5 0 3 1.5 4 3-1-1.5-2.5-3-4-3a3 3 0 0 0-3 3Z"/>
                </svg>
                <span>Kişiye Özel Hediyelik</span>
            </a>

            <!-- Lazer Kesim & Baskı -->
            <a href="/kategori/lazer-kesim-baski" class="nav-pill" style="display: inline-flex; align-items: center; gap: 6px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="6 3 2 9 12 21 22 9 18 3 6 3"/>
                    <line x1="12" y1="21" x2="12" y2="9"/>
                    <line x1="2" y1="9" x2="22" y2="9"/>
                </svg>
                <span>Lazer Kesim & Baskı</span>
            </a>

            <!-- Epoksi & Reçine Sanatı -->
            <a href="/kategori/epoksi-recine-sanati" class="nav-pill" style="display: inline-flex; align-items: center; gap: 6px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
                </svg>
                <span>Epoksi & Reçine Sanatı</span>
            </a>

            <!-- El Örgüsü & Makrome -->
            <a href="/kategori/el-orgusu-makrome" class="nav-pill" style="display: inline-flex; align-items: center; gap: 6px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.2 6 3 11l-.9-2.4c-.5-1.1 0-2.4 1.1-2.9L16 2.1c1.1-.5 2.4 0 2.9 1.1z"/>
                    <path d="m4 12 8 8"/>
                    <path d="M12 4v16"/>
                    <path d="m8 16 8-8"/>
                </svg>
                <span>El Örgüsü & Makrome</span>
            </a>

            <!-- Hakiki Deri Tasarımlar -->
            <a href="/kategori/hakiki-deri-tasarimlar" class="nav-pill" style="display: inline-flex; align-items: center; gap: 6px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                </svg>
                <span>Hakiki Deri Tasarımlar</span>
            </a>

            <!-- Seramik & Çömlek -->
            <a href="/kategori/seramik-comlek" class="nav-pill" style="display: inline-flex; align-items: center; gap: 6px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 8h1a4 4 0 1 1 0 8h-1"/>
                    <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/>
                    <line x1="6" y1="2" x2="6" y2="4"/>
                    <line x1="10" y1="2" x2="10" y2="4"/>
                    <line x1="14" y1="2" x2="14" y2="4"/>
                </svg>
                <span>Seramik & Çömlek</span>
            </a>
        </nav>
    </div>
</header>

<style>
@media (max-width: 640px) {
    .d-block-mobile {
        display: inline-block !important;
    }
    .header-top {
        padding: 0.3rem 0;
        font-size: 0.72rem;
    }
}
</style>
