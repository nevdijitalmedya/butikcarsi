---
import type { Product } from '../lib/data';

interface Props {
    product: Product;
}

const { product } = Astro.props;
---

<div class="card product-card">
    <div class="product-card-img-wrap" style="position: relative; aspect-ratio: 1/1; overflow: hidden; background: #eee;">
        <a href={`/urun/${product.slug}`}>
            <img 
                src={product.primary_image} 
                alt={product.name} 
                loading="lazy"
                style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease;"
                class="hover-zoom"
            />
        </a>
        <div style="position: absolute; top: 10px; left: 10px; display: flex; flex-direction: column; gap: 5px;">
            {product.customizable && (
                <span class="badge badge-custom">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                    <span>Kişiye Özel</span>
                </span>
            )}
            {product.free_shipping && (
                <span class="badge badge-free-shipping">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                    <span>Ücretsiz Kargo</span>
                </span>
            )}
        </div>
    </div>

    <div style="padding: 1.2rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
            <a href={`/uretici/${product.producer_slug}`} style="font-size: 0.82rem; font-weight: 600; color: var(--color-primary); display: flex; align-items: center; gap: 5px;">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m2 7 4.4-4.4A2 2 0 0 1 7.8 2h8.4a2 2 0 0 1 1.4.6L22 7"/><path d="M22 7v13a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7"/></svg>
                <span>{product.producer_name}</span>
            </a>
            <span style="font-size: 0.75rem; color: #64748b; display: flex; align-items: center; gap: 3px;">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                {product.producer_city}
            </span>
        </div>

        <h3 style="font-size: 1rem; margin-bottom: 0.5rem; font-weight: 600; line-height: 1.4;">
            <a href={`/urun/${product.slug}`}>{product.name}</a>
        </h3>

        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-top: 1rem; padding-top: 0.8rem; border-top: 1px solid var(--color-border-subtle);">
            <div>
                {product.sale_price ? (
                    <div style="display: flex; align-items: baseline; gap: 6px;">
                        <span style="font-size: 1.25rem; font-weight: 800; color: var(--color-primary);">₺{product.sale_price.toLocaleString('tr-TR', { minimumFractionDigits: 2 })}</span>
                        <del style="font-size: 0.85rem; color: #94a3b8;">₺{product.regular_price.toLocaleString('tr-TR', { minimumFractionDigits: 2 })}</del>
                    </div>
                ) : (
                    <span style="font-size: 1.25rem; font-weight: 800; color: var(--color-ink);">₺{product.regular_price.toLocaleString('tr-TR', { minimumFractionDigits: 2 })}</span>
                )}
            </div>

            <a href={`/urun/${product.slug}`} class="btn btn-sm btn-secondary">
                İncele
            </a>
        </div>
    </div>
</div>

<style>
.hover-zoom:hover {
    transform: scale(1.04);
}
</style>
