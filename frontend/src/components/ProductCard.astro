---
import type { Product } from '../lib/data';

interface Props {
    product: Product;
}

const { product } = Astro.props;
---

<div class="card product-card">
    <div class="product-card-img-wrap" style="position: relative; aspect-ratio: 1/1; overflow: hidden; background: #eee;">
        <a href={`/urun/${product.slug}`}>
            <img 
                src={product.primary_image} 
                alt={product.name} 
                loading="lazy"
                style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease;"
                class="hover-zoom"
            />
        </a>
        <div style="position: absolute; top: 10px; left: 10px; display: flex; flex-direction: column; gap: 5px;">
            {product.customizable && (
                <span class="badge badge-custom">✏️ Kişiye Özel</span>
            )}
            {product.free_shipping && (
                <span class="badge badge-free-shipping">📦 Ücretsiz Kargo</span>
            )}
        </div>
    </div>

    <div style="padding: 1.2rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
            <a href={`/uretici/${product.producer_slug}`} style="font-size: 0.8rem; font-weight: 600; color: var(--color-primary); display: flex; align-items: center; gap: 4px;">
                <span>🏪 {product.producer_name}</span>
            </a>
            <span style="font-size: 0.75rem; color: #64748b;">📍 {product.producer_city}</span>
        </div>

        <h3 style="font-size: 1rem; margin-bottom: 0.5rem; font-weight: 600; line-height: 1.4;">
            <a href={`/urun/${product.slug}`}>{product.name}</a>
        </h3>

        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-top: 1rem; padding-top: 0.8rem; border-top: 1px solid var(--color-border-light);">
            <div>
                {product.sale_price ? (
                    <div style="display: flex; align-items: baseline; gap: 6px;">
                        <span style="font-size: 1.25rem; font-weight: 800; color: var(--color-primary);">₺{product.sale_price.toLocaleString('tr-TR', { minimumFractionDigits: 2 })}</span>
                        <del style="font-size: 0.85rem; color: #94a3b8;">₺{product.regular_price.toLocaleString('tr-TR', { minimumFractionDigits: 2 })}</del>
                    </div>
                ) : (
                    <span style="font-size: 1.25rem; font-weight: 800; color: var(--color-dark);">₺{product.regular_price.toLocaleString('tr-TR', { minimumFractionDigits: 2 })}</span>
                )}
            </div>

            <a href={`/urun/${product.slug}`} class="btn btn-sm btn-secondary">
                İncele
            </a>
        </div>
    </div>
</div>

<style>
.hover-zoom:hover {
    transform: scale(1.05);
}
</style>
