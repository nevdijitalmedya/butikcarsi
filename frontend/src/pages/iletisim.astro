---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="İletişim & Destek">
    <div class="container" style="padding: 4rem 1.5rem; max-width: 700px;">
        <h1 style="font-size: 2.5rem; margin-bottom: 1rem;">İletişim & Destek</h1>
        <p style="color: #64748b; margin-bottom: 2rem;">Sorularınız veya üretici başvurusu için bize her zaman ulaşabilirsiniz.</p>

        <div class="card" style="padding: 2rem;">
            <form onsubmit="event.preventDefault(); alert('Mesajınız başarıyla iletildi. En kısa sürede dönüş yapacağız!');">
                <div style="margin-bottom: 1rem;">
                    <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem;">Adınız Soyadınız *</label>
                    <input type="text" required style="width: 100%; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm);">
                </div>
                <div style="margin-bottom: 1rem;">
                    <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem;">E-Posta Adresiniz *</label>
                    <input type="email" required style="width: 100%; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm);">
                </div>
                <div style="margin-bottom: 1rem;">
                    <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem;">Konu</label>
                    <input type="text" style="width: 100%; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm);">
                </div>
                <div style="margin-bottom: 1.5rem;">
                    <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem;">Mesajınız *</label>
                    <textarea required rows="4" style="width: 100%; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm);"></textarea>
                </div>
                <button type="submit" class="btn btn-primary btn-block" style="width: 100%;">Mesaj Gönder</button>
            </form>
        </div>
    </div>
</BaseLayout>
