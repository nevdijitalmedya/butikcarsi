---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { PRODUCERS, PRODUCTS, getProducerBySlug, getProductsByProducer } from '../../lib/data';

export function getStaticPaths() {
    return PRODUCERS.map(producer => ({
        params: { slug: producer.slug },
        props: { producer }
    }));
}

const { producer } = Astro.props;
const products = getProductsByProducer(producer.slug);
---

<BaseLayout 
    title={`${producer.brand_name} — Butik Atölye & Ürünleri`}
    description={`${producer.brand_name} atölyesinin kişiye özel el yapımı ürünlerini ButikÇarşı güvencesiyle satın alın.`}
    image={producer.cover_image_url}
>
    <!-- PRODUCER HERO BANNER -->
    <div style="position: relative; height: 320px; overflow: hidden; background: #334155;">
        <img 
            src={producer.cover_image_url} 
            alt={producer.brand_name} 
            style="width: 100%; height: 100%; object-fit: cover; opacity: 0.85;"
        />
        <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.7) 100%);"></div>
    </div>

    <!-- PRODUCER PROFILE HEADER -->
    <div class="container" style="margin-top: -80px; position: relative; z-index: 10;">
        <div class="card" style="padding: 2rem; display: flex; gap: 2rem; align-items: center; flex-wrap: wrap; box-shadow: 0 10px 30px rgba(0,0,0,0.08);">
            <img 
                src={producer.logo_url} 
                alt={producer.brand_name} 
                style="width: 110px; height: 110px; border-radius: 999px; object-fit: cover; border: 4px solid #fff; box-shadow: 0 4px 15px rgba(0,0,0,0.15);"
            />

            <div style="flex: 1; min-width: 260px;">
                <div style="display: flex; align-items: center; gap: 0.8rem; margin-bottom: 0.4rem;">
                    <h1 style="font-size: 2rem; font-weight: 800; margin: 0;">{producer.brand_name}</h1>
                    <span class="badge badge-verified"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;margin-right:3px;"><polyline points="20 6 9 17 4 12"/></svg> Onaylı Butik</span>
                </div>
                <div style="display: flex; gap: 1rem; align-items: center; font-size: 0.9rem; color: #64748b; margin-bottom: 0.8rem; flex-wrap: wrap;">
                    <span><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;margin-right:3px;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg> {producer.district}, {producer.city}</span>
                    <span><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;margin-right:3px;"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/></svg> {producer.category}</span>
                    <span>⭐ <strong>{producer.rating}</strong> ({producer.review_count} değerlendirme)</span>
                    <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;margin-right:4px;"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg> {producer.sales_count}+ başarılı teslimat</span>
                </div>
                <p style="font-size: 0.95rem; color: var(--color-dark); line-height: 1.5; max-width: 700px;">
                    {producer.description}
                </p>
            </div>

            <div style="display: flex; flex-direction: column; gap: 0.6rem; min-width: 200px;">
                <a href={producer.instagram_url} target="_blank" rel="noopener" class="btn btn-instagram btn-sm" style="width: 100%;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;margin-right:5px;"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg> Instagram: {producer.instagram_handle}
                </a>
                <a href={`https://wa.me/${producer.whatsapp_number.replace(/[^0-9]/g, '')}?text=Merhaba,%20ButikÇarşı%20üzerinden%20ürünlerinizle%20ilgili%20bilgi%20almak%20istiyorum.`} target="_blank" rel="noopener" class="btn btn-whatsapp btn-sm" style="width: 100%;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;margin-right:5px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg> WhatsApp ile Yaz
                </a>
            </div>
        </div>
    </div>

    <!-- PRODUCER PRODUCTS -->
    <section style="padding: 3.5rem 0;">
        <div class="container">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
                <div>
                    <h2 style="font-size: 1.7rem;">Atölye Ürünleri ({products.length})</h2>
                    <p style="color: #64748b; font-size: 0.9rem;">Tüm ürünler doğrudan {producer.brand_name} atölyesinde hazırlanmaktadır.</p>
                </div>
            </div>

            {products.length === 0 ? (
                <div class="card" style="padding: 3rem; text-align: center;">
                    <p style="color: #64748b;">Bu üreticiye ait henüz yayında bir ürün bulunmuyor.</p>
                </div>
            ) : (
                <div class="grid-4">
                    {products.map(product => (
                        <ProductCard product={product} />
                    ))}
                </div>
            )}
        </div>
    </section>

    <!-- PRODUCER GUARANTEE BANNER -->
    <section style="padding: 2.5rem 0; background: #fff; border-top: 1px solid var(--color-border);">
        <div class="container">
            <div class="value-props-grid">
                <div>
                    <div style="margin-bottom: 0.4rem;"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
                    <div style="font-weight: 700; margin-bottom: 0.2rem;">%100 Para İadesi Garantisi</div>
                    <div style="font-size: 0.85rem; color: #64748b;">Ürün kargolanmazsa anında tam iade</div>
                </div>
                <div>
                    <div style="margin-bottom: 0.4rem;"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg></div>
                    <div style="font-weight: 700; margin-bottom: 0.2rem;">Doğrudan Üretici İletişimi</div>
                    <div style="font-size: 0.85rem; color: #64748b;">Özel sipariş detaylarınızı WhatsApp'tan teyit edin</div>
                </div>
                <div>
                    <div style="margin-bottom: 0.4rem;"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/></svg></div>
                    <div style="font-weight: 700; margin-bottom: 0.2rem;">Orijinal & Faturalı</div>
                    <div style="font-size: 0.85rem; color: #64748b;">Platform denetimli onaylı butik üretici</div>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
