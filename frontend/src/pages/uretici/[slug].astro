---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { PRODUCERS, PRODUCTS, getProducerBySlug, getProductsByProducer } from '../../lib/data';

export function getStaticPaths() {
    return PRODUCERS.map(producer => ({
        params: { slug: producer.slug },
        props: { producer }
    }));
}

const { producer } = Astro.props;
const products = getProductsByProducer(producer.slug);
---

<BaseLayout 
    title={`${producer.brand_name} — Butik Atölye & Ürünleri`}
    description={`${producer.brand_name} atölyesinin kişiye özel el yapımı ürünlerini ButikÇarşı güvencesiyle satın alın.`}
    image={producer.cover_image_url}
>
    <!-- PRODUCER HERO BANNER -->
    <div style="position: relative; height: 320px; overflow: hidden; background: #334155;">
        <img 
            src={producer.cover_image_url} 
            alt={producer.brand_name} 
            style="width: 100%; height: 100%; object-fit: cover; opacity: 0.85;"
        />
        <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.7) 100%);"></div>
    </div>

    <!-- PRODUCER PROFILE HEADER -->
    <div class="container" style="margin-top: -80px; position: relative; z-index: 10;">
        <div class="card" style="padding: 2rem; display: flex; gap: 2rem; align-items: center; flex-wrap: wrap; box-shadow: 0 10px 30px rgba(0,0,0,0.08);">
            <img 
                src={producer.logo_url} 
                alt={producer.brand_name} 
                style="width: 110px; height: 110px; border-radius: 999px; object-fit: cover; border: 4px solid #fff; box-shadow: 0 4px 15px rgba(0,0,0,0.15);"
            />

            <div style="flex: 1; min-width: 260px;">
                <div style="display: flex; align-items: center; gap: 0.8rem; margin-bottom: 0.4rem;">
                    <h1 style="font-size: 2rem; font-weight: 800; margin: 0;">{producer.brand_name}</h1>
                    <span class="badge badge-verified">✓ Onaylı Butik</span>
                </div>
                <div style="display: flex; gap: 1rem; align-items: center; font-size: 0.9rem; color: #64748b; margin-bottom: 0.8rem; flex-wrap: wrap;">
                    <span>📍 {producer.district}, {producer.city}</span>
                    <span>🏷️ {producer.category}</span>
                    <span>⭐ <strong>{producer.rating}</strong> ({producer.review_count} değerlendirme)</span>
                    <span>🛍️ {producer.sales_count}+ başarılı teslimat</span>
                </div>
                <p style="font-size: 0.95rem; color: var(--color-dark); line-height: 1.5; max-width: 700px;">
                    {producer.description}
                </p>
            </div>

            <div style="display: flex; flex-direction: column; gap: 0.6rem; min-width: 200px;">
                <a href={producer.instagram_url} target="_blank" rel="noopener" class="btn btn-instagram btn-sm" style="width: 100%;">
                    📸 Instagram: {producer.instagram_handle}
                </a>
                <a href={`https://wa.me/${producer.whatsapp_number.replace(/[^0-9]/g, '')}?text=Merhaba,%20ButikÇarşı%20üzerinden%20ürünlerinizle%20ilgili%20bilgi%20almak%20istiyorum.`} target="_blank" rel="noopener" class="btn btn-whatsapp btn-sm" style="width: 100%;">
                    💬 WhatsApp ile Yaz
                </a>
            </div>
        </div>
    </div>

    <!-- PRODUCER PRODUCTS -->
    <section style="padding: 3.5rem 0;">
        <div class="container">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
                <div>
                    <h2 style="font-size: 1.7rem;">Atölye Ürünleri ({products.length})</h2>
                    <p style="color: #64748b; font-size: 0.9rem;">Tüm ürünler doğrudan {producer.brand_name} atölyesinde hazırlanmaktadır.</p>
                </div>
            </div>

            {products.length === 0 ? (
                <div class="card" style="padding: 3rem; text-align: center;">
                    <p style="color: #64748b;">Bu üreticiye ait henüz yayında bir ürün bulunmuyor.</p>
                </div>
            ) : (
                <div class="grid-4">
                    {products.map(product => (
                        <ProductCard product={product} />
                    ))}
                </div>
            )}
        </div>
    </section>

    <!-- PRODUCER GUARANTEE BANNER -->
    <section style="padding: 2.5rem 0; background: #fff; border-top: 1px solid var(--color-border);">
        <div class="container">
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; text-align: center;">
                <div>
                    <div style="font-size: 1.8rem; margin-bottom: 0.4rem;">🛡️</div>
                    <div style="font-weight: 700; margin-bottom: 0.2rem;">%100 Para İadesi Garantisi</div>
                    <div style="font-size: 0.85rem; color: #64748b;">Ürün kargolanmazsa anında tam iade</div>
                </div>
                <div>
                    <div style="font-size: 1.8rem; margin-bottom: 0.4rem;">💬</div>
                    <div style="font-weight: 700; margin-bottom: 0.2rem;">Doğrudan Üretici İletişimi</div>
                    <div style="font-size: 0.85rem; color: #64748b;">Özel sipariş detaylarınızı WhatsApp'tan teyit edin</div>
                </div>
                <div>
                    <div style="font-size: 1.8rem; margin-bottom: 0.4rem;">✨</div>
                    <div style="font-weight: 700; margin-bottom: 0.2rem;">Orijinal & Faturalı</div>
                    <div style="font-size: 0.85rem; color: #64748b;">Platform denetimli onaylı butik üretici</div>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
