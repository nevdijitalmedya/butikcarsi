---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Siparişiniz Alındı!">
    <div class="container" style="padding: 4rem 1.5rem; text-align: center; max-width: 680px;">
        <div class="card" style="padding: 3.5rem 2rem;">
            <div style="font-size: 4rem; margin-bottom: 1rem;">🎉</div>
            <span class="badge badge-free-shipping" style="font-size: 0.9rem; margin-bottom: 1rem; padding: 0.4rem 1rem;">
                Ödeme Başarıyla Onaylandı
            </span>
            <h1 style="font-size: 2.2rem; margin-bottom: 1rem;">Siparişiniz Alındı!</h1>
            <p style="font-size: 1.1rem; color: #64748b; line-height: 1.6; margin-bottom: 2rem;">
                Tebrikler! Siparişiniz ilgili butik üreticilere iletildi. El emeği ürününüz özenle hazırlanıp kargolanacaktır.
            </p>

            <div style="background: var(--color-bg); padding: 1.5rem; border-radius: var(--radius-md); text-align: left; margin-bottom: 2rem; font-size: 0.9rem;">
                <div style="margin-bottom: 0.5rem;"><strong>Sipariş Kodu:</strong> <span id="display-order-code">BC-2026-XXXXX</span></div>
                <div style="margin-bottom: 0.5rem;"><strong>Ödeme Durumu:</strong> iyzico 3D Secure ile Ödendi (Escrow Korumalı)</div>
                <div><strong>Kargo Bildirimi:</strong> Kargo takip numarası SMS ve E-posta ile tarafınıza iletilecektir.</div>
            </div>

            <div style="display: flex; gap: 1rem; justify-content: center;">
                <a href="/" class="btn btn-primary">Anasayfaya Dön</a>
                <a href="/kesfet" class="btn btn-secondary">Diğer Butikleri Keşfet</a>
            </div>
        </div>
    </div>

    <script is:inline>
        window.addEventListener('DOMContentLoaded', () => {
            const params = new URLSearchParams(window.location.search);
            const code = params.get('order') || 'BC-2026-78412';
            const el = document.getElementById('display-order-code');
            if (el) el.textContent = code;
        });
    </script>
</BaseLayout>
