---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { PRODUCTS, getProductBySlug, getProducerBySlug } from '../../lib/data';

export function getStaticPaths() {
    return PRODUCTS.map(product => ({
        params: { slug: product.slug },
        props: { product }
    }));
}

const { product } = Astro.props;
const producer = getProducerBySlug(product.producer_slug);
const relatedProducts = PRODUCTS.filter(p => p.producer_slug === product.producer_slug && p.id !== product.id).slice(0, 4);
---

<BaseLayout 
    title={`${product.name} — ${product.producer_name}`}
    description={product.short_description}
    image={product.primary_image}
>
    <div class="container" style="padding: 2.5rem 1.5rem;">
        <!-- Breadcrumb -->
        <nav style="font-size: 0.85rem; color: #64748b; margin-bottom: 2rem;">
            <a href="/">Anasayfa</a> &gt; 
            <a href={`/uretici/${product.producer_slug}`}>{product.producer_name}</a> &gt; 
            <span style="color: var(--color-dark); font-weight: 600;">{product.name}</span>
        </nav>

        <div style="display: grid; grid-template-columns: 1.1fr 1fr; gap: 3.5rem; align-items: start;">
            <!-- PRODUCT GALLERY -->
            <div>
                <div class="card" style="border-radius: var(--radius-lg); overflow: hidden; margin-bottom: 1rem;">
                    <img 
                        id="main-product-img"
                        src={product.primary_image} 
                        alt={product.name} 
                        style="width: 100%; height: 500px; object-fit: cover;"
                    />
                </div>
                {product.images.length > 1 && (
                    <div style="display: flex; gap: 0.8rem;">
                        {product.images.map(img => (
                            <img 
                                src={img} 
                                alt={product.name}
                                style="width: 80px; height: 80px; border-radius: var(--radius-sm); object-fit: cover; cursor: pointer; border: 2px solid var(--color-border);"
                                onclick="document.getElementById('main-product-img').src = this.src;"
                            />
                        ))}
                    </div>
                )}
            </div>

            <!-- PRODUCT INFO & BUY FORM -->
            <div>
                <!-- Producer Link Card -->
                <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.8rem 1rem; background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-md); margin-bottom: 1.5rem;">
                    <div style="display: flex; align-items: center; gap: 0.8rem;">
                        {producer && (
                            <img src={producer.logo_url} alt={producer.brand_name} style="width: 40px; height: 40px; border-radius: 999px; object-fit: cover;" />
                        )}
                        <div>
                            <div style="font-weight: 700; font-size: 0.95rem;">
                                <a href={`/uretici/${product.producer_slug}`}>{product.producer_name}</a>
                            </div>
                            <span style="font-size: 0.75rem; color: #64748b;"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;margin-right:3px;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg> {product.producer_city} • ⭐ {product.rating}</span>
                        </div>
                    </div>
                    {producer && (
                        <a href={producer.instagram_url} target="_blank" rel="noopener" class="btn btn-sm btn-instagram" style="font-size: 0.75rem;">
                            {producer.instagram_handle}
                        </a>
                    )}
                </div>

                <div style="display: flex; gap: 0.5rem; margin-bottom: 0.8rem;">
                    {product.customizable && <span class="badge badge-custom"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;margin-right:4px;"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg> Kişiye Özel Üretim</span>}
                    {product.free_shipping && <span class="badge badge-free-shipping"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;margin-right:4px;"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg> Ücretsiz Kargo</span>}
                </div>

                <h1 style="font-size: 2rem; margin-bottom: 1rem; font-weight: 800; line-height: 1.25;">{product.name}</h1>

                <p style="font-size: 1rem; color: #64748b; margin-bottom: 1.5rem; line-height: 1.5;">
                    {product.short_description}
                </p>

                <!-- PRICE -->
                <div style="background: #fff; padding: 1.2rem; border-radius: var(--radius-md); border: 1px solid var(--color-border); margin-bottom: 1.8rem; display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <span style="font-size: 0.8rem; color: #64748b; display: block;">Fiyat:</span>
                        {product.sale_price ? (
                            <div style="display: flex; align-items: baseline; gap: 8px;">
                                <span style="font-size: 2rem; font-weight: 800; color: var(--color-primary);">₺{product.sale_price.toLocaleString('tr-TR', { minimumFractionDigits: 2 })}</span>
                                <del style="font-size: 1.1rem; color: #94a3b8;">₺{product.regular_price.toLocaleString('tr-TR', { minimumFractionDigits: 2 })}</del>
                            </div>
                        ) : (
                            <span style="font-size: 2rem; font-weight: 800; color: var(--color-dark);">₺{product.regular_price.toLocaleString('tr-TR', { minimumFractionDigits: 2 })}</span>
                        )}
                    </div>
                    <div style="text-align: right;">
                        <span class="badge badge-free-shipping" style="font-size: 0.8rem;">Stokta Var</span>
                    </div>
                </div>

                <!-- PERSONALIZATION FORM IF CUSTOMIZABLE -->
                {product.customizable && (
                    <div style="background: #fff8f5; border: 1px solid #fbdcd0; padding: 1.5rem; border-radius: var(--radius-md); margin-bottom: 1.8rem;">
                        <label style="display: block; font-weight: 700; margin-bottom: 0.4rem; color: var(--color-primary);">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;margin-right:4px;"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg> Kişiselleştirme Notunuz *
                        </label>
                        <p style="font-size: 0.85rem; color: #64748b; margin-bottom: 0.8rem;">
                            {product.customization_note || 'Ürün üzerine yazılacak isim, tarih veya fotoğraf detayını buraya yazınız:'}
                        </p>
                        <textarea 
                            id="customization-text" 
                            rows="3" 
                            placeholder="Örn: Kolye plakasına 'Canan - 15.08.2023' yazılsın."
                            style="width: 100%; padding: 0.8rem; border-radius: var(--radius-sm); border: 1px solid #e2c0b0; font-family: inherit; font-size: 0.9rem;"
                        ></textarea>
                    </div>
                )}

                <!-- ADD TO CART -->
                <div style="display: flex; gap: 1rem; margin-bottom: 2rem;">
                    <div style="width: 90px;">
                        <input 
                            type="number" 
                            id="cart-quantity" 
                            value="1" 
                            min="1" 
                            max="20"
                            style="width: 100%; height: 50px; text-align: center; font-size: 1.1rem; font-weight: 700; border-radius: var(--radius-md); border: 1px solid var(--color-border);"
                        />
                    </div>
                    <button 
                        id="add-to-cart-btn"
                        class="btn btn-primary" 
                        style="flex: 1; height: 50px; font-size: 1.05rem;"
                    >
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg> Sepete Ekle
                    </button>
                </div>

                <!-- SPECS TABLE -->
                <div class="card" style="padding: 1.2rem;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; font-size: 0.88rem;">
                        <div><strong>Malzeme:</strong> {product.material}</div>
                        <div><strong>Hazırlanma Süresi:</strong> {product.production_time}</div>
                        <div><strong>Kargo:</strong> {product.free_shipping ? 'Ücretsiz Kargo' : `₺${product.shipping_cost}`}</div>
                        <div><strong>Ödeme Koruması:</strong> %100 Escrow Güvencesi</div>
                    </div>
                </div>

                <!-- DESCRIPTION -->
                <div style="margin-top: 2rem;">
                    <h3 style="font-size: 1.2rem; margin-bottom: 0.8rem;">Ürün Hikayesi & Detayları</h3>
                    <p style="font-size: 0.95rem; color: var(--color-dark-muted); line-height: 1.7; white-space: pre-line;">
                        {product.description}
                    </p>
                </div>
            </div>
        </div>

        <!-- RELATED PRODUCTS -->
        {relatedProducts.length > 0 && (
            <div style="margin-top: 5rem; padding-top: 3rem; border-top: 1px solid var(--color-border);">
                <h2 style="font-size: 1.8rem; margin-bottom: 2rem;">Bu Atölyenin Diğer Ürünleri</h2>
                <div class="grid-4">
                    {relatedProducts.map(p => (
                        <ProductCard product={p} />
                    ))}
                </div>
            </div>
        )}
    </div>

    <script is:inline define:vars={{ product }}>
        document.getElementById('add-to-cart-btn').addEventListener('click', function() {
            const qty = parseInt(document.getElementById('cart-quantity').value) || 1;
            const customInput = document.getElementById('customization-text');
            const customText = customInput ? customInput.value.trim() : '';

            if (product.customizable && !customText) {
                alert('Lütfen kişiselleştirme notunuzu giriniz.');
                if (customInput) customInput.focus();
                return;
            }

            const cartItem = {
                id: product.id,
                slug: product.slug,
                name: product.name,
                price: product.sale_price || product.regular_price,
                image: product.primary_image,
                producer_slug: product.producer_slug,
                producer_name: product.producer_name,
                quantity: qty,
                customization: customText
            };

            let cart = [];
            try {
                cart = JSON.parse(localStorage.getItem('bc_cart') || '[]');
            } catch(e) {}

            const existingIdx = cart.findIndex(i => i.id === product.id && i.customization === customText);
            if (existingIdx > -1) {
                cart[existingIdx].quantity += qty;
            } else {
                cart.push(cartItem);
            }

            localStorage.setItem('bc_cart', JSON.stringify(cart));
            window.dispatchEvent(new Event('storage'));
            
            if (confirm('Ürün sepete eklendi! Sepete gitmek ister misiniz?')) {
                window.location.href = '/sepet';
            }
        });
    </script>
</BaseLayout>
