---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Alışveriş Sepetim">
    <div class="container" style="padding: 3rem 1.5rem;">
        <h1 style="font-size: 2.2rem; margin-bottom: 2rem;">Alışveriş Sepetim</h1>

        <div id="cart-empty" class="card" style="padding: 4rem 2rem; text-align: center; display: none;">
            <div style="margin-bottom: 1rem; color: #94a3b8;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></div>
            <h2 style="font-size: 1.5rem; margin-bottom: 0.5rem;">Sepetiniz henüz boş</h2>
            <p style="color: #64748b; margin-bottom: 1.5rem;">Instagram butik üreticilerimizin el emeği ürünlerini keşfetmeye ne dersiniz?</p>
            <a href="/kesfet" class="btn btn-primary">Ürünleri Keşfet</a>
        </div>

        <div id="cart-content" class="cart-grid">
            <div>
                <div class="card" style="padding: 1.5rem;">
                    <div id="cart-items-list">
                        <!-- Rendered by JS -->
                    </div>
                </div>
            </div>

            <div>
                <div class="card" style="padding: 1.8rem;">
                    <h3 style="font-size: 1.2rem; margin-bottom: 1.2rem;">Sipariş Özeti</h3>

                    <div style="display: flex; justify-content: space-between; margin-bottom: 0.8rem; font-size: 0.95rem;">
                        <span style="color: #64748b;">Ürünler Toplamı:</span>
                        <strong id="cart-subtotal">₺0,00</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 0.8rem; font-size: 0.95rem;">
                        <span style="color: #64748b;">Kargo:</span>
                        <span class="badge badge-free-shipping">Ücretsiz</span>
                    </div>

                    <div style="border-top: 1px solid var(--color-border); padding-top: 1rem; margin-top: 1rem; display: flex; justify-content: space-between; align-items: baseline;">
                        <span style="font-size: 1.1rem; font-weight: 700;">Toplam Tutar:</span>
                        <span id="cart-total" style="font-size: 1.6rem; font-weight: 800; color: var(--color-primary);">₺0,00</span>
                    </div>

                    <div style="margin-top: 1.5rem;">
                        <a href="/odeme" class="btn btn-primary btn-block" style="width: 100%; height: 50px; font-size: 1.05rem;">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;margin-right:4px;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg> Güvenli Ödemeye Geç
                        </a>
                    </div>

                    <div style="margin-top: 1.2rem; padding: 0.8rem; background: var(--color-bg); border-radius: var(--radius-sm); font-size: 0.8rem; color: #64748b; line-height: 1.4;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ff8a65" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;margin-right:4px;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> <strong>Escrow Güvencesi:</strong> Ödemeniz siparişiniz size ulaşana dek iyzico emanet havuzunda bekletilir.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script is:inline>
        function renderCart() {
            const emptyEl = document.getElementById('cart-empty');
            const contentEl = document.getElementById('cart-content');
            const itemsList = document.getElementById('cart-items-list');

            let cart = [];
            try {
                cart = JSON.parse(localStorage.getItem('bc_cart') || '[]');
            } catch(e) {}

            if (cart.length === 0) {
                emptyEl.style.display = 'block';
                contentEl.style.display = 'none';
                return;
            }

            emptyEl.style.display = 'none';
            contentEl.style.display = 'grid';

            let subtotal = 0;
            let html = '';

            cart.forEach((item, idx) => {
                const itemTotal = item.price * item.quantity;
                subtotal += itemTotal;

                html += `
                    <div style="display: flex; gap: 1.2rem; padding: 1.2rem 0; border-bottom: 1px solid var(--color-border-light); align-items: center;">
                        <img src="${item.image}" alt="${item.name}" style="width: 75px; height: 75px; object-fit: cover; border-radius: var(--radius-sm);">
                        <div style="flex: 1;">
                            <div style="font-size: 0.8rem; color: var(--color-primary); font-weight: 600;">${item.producer_name}</div>
                            <h4 style="font-size: 1rem; font-weight: 600; margin-bottom: 0.3rem;"><a href="/urun/${item.slug}">${item.name}</a></h4>
                            ${item.customization ? `<div style="font-size: 0.8rem; color: #b45309; background: #fef3c7; padding: 2px 6px; border-radius: 4px; display: inline-block;">Özel Not: ${item.customization}</div>` : ''}
                            <div style="font-size: 0.95rem; font-weight: 700; margin-top: 0.4rem;">₺${item.price.toLocaleString('tr-TR', {minimumFractionDigits: 2})}</div>
                        </div>
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <button onclick="changeQty(${idx}, -1)" class="btn btn-sm btn-secondary" style="padding: 4px 10px;">-</button>
                            <span style="font-weight: 700; width: 24px; text-align: center;">${item.quantity}</span>
                            <button onclick="changeQty(${idx}, 1)" class="btn btn-sm btn-secondary" style="padding: 4px 10px;">+</button>
                        </div>
                        <div style="text-align: right; min-width: 90px;">
                            <div style="font-size: 1.1rem; font-weight: 800; color: var(--color-dark);">₺${itemTotal.toLocaleString('tr-TR', {minimumFractionDigits: 2})}</div>
                            <button onclick="removeItem(${idx})" style="background: none; border: none; color: #ef4444; font-size: 0.8rem; cursor: pointer; margin-top: 4px;">Kaldır</button>
                        </div>
                    </div>
                `;
            });

            itemsList.innerHTML = html;
            document.getElementById('cart-subtotal').textContent = '₺' + subtotal.toLocaleString('tr-TR', {minimumFractionDigits: 2});
            document.getElementById('cart-total').textContent = '₺' + subtotal.toLocaleString('tr-TR', {minimumFractionDigits: 2});
        }

        window.changeQty = function(idx, diff) {
            let cart = JSON.parse(localStorage.getItem('bc_cart') || '[]');
            if (cart[idx]) {
                cart[idx].quantity += diff;
                if (cart[idx].quantity <= 0) {
                    cart.splice(idx, 1);
                }
                localStorage.setItem('bc_cart', JSON.stringify(cart));
                window.dispatchEvent(new Event('storage'));
                renderCart();
            }
        };

        window.removeItem = function(idx) {
            let cart = JSON.parse(localStorage.getItem('bc_cart') || '[]');
            cart.splice(idx, 1);
            localStorage.setItem('bc_cart', JSON.stringify(cart));
            window.dispatchEvent(new Event('storage'));
            renderCart();
        };

        window.addEventListener('DOMContentLoaded', renderCart);
    </script>
</BaseLayout>
