---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Güvenli Ödeme & Teslimat">
    <div class="container" style="padding: 3rem 1.5rem;">
        <h1 style="font-size: 2.2rem; margin-bottom: 2rem;">Güvenli Ödeme & Teslimat</h1>

        <div class="checkout-grid">
            <div>
                <div class="card" style="padding: 2rem; margin-bottom: 2rem;">
                    <h3 style="font-size: 1.25rem; margin-bottom: 1.2rem;">1. Teslimat Adresi Bilgileri</h3>
                    <form id="checkout-form" onsubmit="event.preventDefault(); submitOrder();">
                        <div class="form-row-responsive">
                            <div>
                                <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem;">Adınız Soyadınız *</label>
                                <input type="text" id="cust-name" required placeholder="Canan Özdemir" style="width: 100%; padding: 0.75rem; border-radius: var(--radius-sm); border: 1px solid var(--color-border);">
                            </div>
                            <div>
                                <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem;">Telefon Numarası *</label>
                                <input type="tel" id="cust-phone" required placeholder="0532 000 00 00" style="width: 100%; padding: 0.75rem; border-radius: var(--radius-sm); border: 1px solid var(--color-border);">
                            </div>
                        </div>

                        <div style="margin-bottom: 1rem;">
                            <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem;">E-Posta Adresi (Sipariş Onayı İçin) *</label>
                            <input type="email" id="cust-email" required placeholder="ornek@mail.com" style="width: 100%; padding: 0.75rem; border-radius: var(--radius-sm); border: 1px solid var(--color-border);">
                        </div>

                        <div class="form-row-responsive">
                            <div>
                                <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem;">İl *</label>
                                <input type="text" id="cust-city" required placeholder="İstanbul" style="width: 100%; padding: 0.75rem; border-radius: var(--radius-sm); border: 1px solid var(--color-border);">
                            </div>
                            <div>
                                <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem;">İlçe *</label>
                                <input type="text" id="cust-district" required placeholder="Kadıköy" style="width: 100%; padding: 0.75rem; border-radius: var(--radius-sm); border: 1px solid var(--color-border);">
                            </div>
                        </div>

                        <div style="margin-bottom: 1.5rem;">
                            <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem;">Açık Teslimat Adresi *</label>
                            <textarea id="cust-address" required rows="3" placeholder="Mahalle, Cadde, Sokak, Bina No, Daire..." style="width: 100%; padding: 0.75rem; border-radius: var(--radius-sm); border: 1px solid var(--color-border);"></textarea>
                        </div>
                    </form>
                </div>

                <div class="card" style="padding: 2rem;">
                    <h3 style="font-size: 1.25rem; margin-bottom: 1.2rem;">2. Ödeme Yöntemi (iyzico Korumalı)</h3>
                    <div style="padding: 1.2rem; border: 2px solid var(--color-primary); border-radius: var(--radius-md); background: #fff8f5; margin-bottom: 1.5rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                            <strong><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;margin-right:6px;"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg> Kredi / Banka Kartı (iyzico 3D Secure)</strong>
                            <span class="badge badge-verified">256-Bit SSL</span>
                        </div>
                        <p style="font-size: 0.85rem; color: #64748b;">
                            Ödemeniz doğrudan iyzico güvenli ödeme geçidi üzerinden işlenecektir. Kart bilgileriniz asla saklanmaz.
                        </p>
                    </div>

                    <button type="button" onclick="submitOrder()" class="btn btn-primary btn-block" style="width: 100%; height: 54px; font-size: 1.1rem;">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;margin-right:4px;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg> Ödemeyi Tamamla ve Siparişi Oluştur
                    </button>
                </div>
            </div>

            <div>
                <div class="card" style="padding: 1.8rem;">
                    <h3 style="font-size: 1.2rem; margin-bottom: 1.2rem;">Sipariş Özeti</h3>
                    <div id="checkout-items-summary" style="margin-bottom: 1.5rem;">
                        <!-- JS items -->
                    </div>

                    <div style="border-top: 1px solid var(--color-border); padding-top: 1rem;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                            <span>Kargo:</span>
                            <span class="badge badge-free-shipping">Ücretsiz</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: baseline; font-size: 1.2rem; font-weight: 800;">
                            <span>Toplam:</span>
                            <span id="checkout-total-price" style="color: var(--color-primary);">₺0,00</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script is:inline>
        window.addEventListener('DOMContentLoaded', () => {
            let cart = [];
            try {
                cart = JSON.parse(localStorage.getItem('bc_cart') || '[]');
            } catch(e) {}

            if (cart.length === 0) {
                window.location.href = '/sepet';
                return;
            }

            const container = document.getElementById('checkout-items-summary');
            let total = 0;
            let html = '';

            cart.forEach(item => {
                const sub = item.price * item.quantity;
                total += sub;
                html += `
                    <div style="display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 0.6rem;">
                        <span>${item.name} x ${item.quantity}</span>
                        <strong>₺${sub.toLocaleString('tr-TR', {minimumFractionDigits: 2})}</strong>
                    </div>
                `;
            });

            container.innerHTML = html;
            document.getElementById('checkout-total-price').textContent = '₺' + total.toLocaleString('tr-TR', {minimumFractionDigits: 2});
        });

        window.submitOrder = function() {
            const name = document.getElementById('cust-name').value.trim();
            const phone = document.getElementById('cust-phone').value.trim();
            const email = document.getElementById('cust-email').value.trim();
            const city = document.getElementById('cust-city').value.trim();
            const address = document.getElementById('cust-address').value.trim();

            if (!name || !phone || !email || !city || !address) {
                alert('Lütfen tüm zorunlu adres alanlarını doldurunuz.');
                return;
            }

            // Clean cart and redirect to success
            localStorage.removeItem('bc_cart');
            window.dispatchEvent(new Event('storage'));
            window.location.href = '/siparis-basarili?order=BC-2026-' + Math.floor(10000 + Math.random() * 90000);
        };
    </script>
</BaseLayout>
